{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mod-scanner",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Builds the in-browser scanner before every `wrangler dev` / `wrangler deploy`.
  "build": { "command": "npm run build:web" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker adds security headers to every page, so it runs before assets.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Per-IP limit on /api/github. Cloudflare counts per location and approximately.
  "ratelimits": [{ "name": "GITHUB_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Turnstile on /api/github: put the widget's site key here (it is public) and
  // the secret in `npx wrangler secret put TURNSTILE_SECRET_KEY`. No secret, no check.
  "vars": { "TURNSTILE_SITE_KEY": "" },
  "observability": { "enabled": true }
}
